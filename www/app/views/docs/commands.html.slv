                    <tr class="border-b border-white/5"><td class="py-3 pr-4" style="vertical-align:top;white-space:nowrap"><a href="#server" class="text-slate-400 hover:text-white">Cluster</a> <span class="text-slate-500 text-sm">(6)</span></td><td class="py-3"><div class="flex flex-wrap gap-2"><code class="px-1.5 py-0.5 rounded bg-white/5 text-slate-300 text-xs font-mono">CLUSTER</code> <code class="px-1.5 py-0.5 rounded bg-white/5 text-slate-300 text-xs font-mono">ASKING</code> <code class="px-1.5 py-0.5 rounded bg-white/5 text-slate-300 text-xs font-mono">READONLY</code> <code class="px-1.5 py-0.5 rounded bg-white/5 text-slate-300 text-xs font-mono">READWRITE</code> <code class="px-1.5 py-0.5 rounded bg-white/5 text-slate-300 text-xs font-mono">MIGRATE</code> <code class="px-1.5 py-0.5 rounded bg-white/5 text-slate-300 text-xs font-mono">RESTORE-ASKING</code></div></td></tr>
